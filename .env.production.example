# ==============================================================================
# ProofLens AI — Production Environment Configuration Template
# File: .env.production.example
# ==============================================================================
# INSTRUCTIONS & DEPLOYMENT ARCHITECTURE:
# 1. This file documents the production configuration for deployed environments:
#    - Backend Web Service: Hosted on Render (https://render.com)
#    - Frontend Web Application: Hosted on Vercel (https://vercel.com)
#    - Database: Hosted on Supabase (PostgreSQL with pgvector)
# 2. DO NOT deploy this file directly. Configure these variables within your
#    respective hosting provider dashboards:
#    - Render Dashboard -> Services -> [prooflens-backend] -> Environment
#    - Vercel Dashboard -> Project Settings -> Environment Variables
# 3. CRITICAL SECURITY RULE:
#    - Backend-only secrets (GEMINI_API_KEY, DATABASE_URL, SUPABASE_SERVICE_ROLE_KEY,
#      AUTH_SECRET_KEY) MUST NEVER be added to Vercel or exposed via NEXT_PUBLIC_*!
#    - Any variable prefixed with NEXT_PUBLIC_* is baked into the browser bundle!
# ==============================================================================


# ==============================================================================
# 1. BACKEND SERVICE CONFIGURATION (Render Dashboard -> Environment)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1.1 Server & Runtime Environment
# ------------------------------------------------------------------------------
# [Required] Set environment mode to production
ENVIRONMENT=production

# [Required] Disable debug mode in production to prevent stack trace leaks
DEBUG=false

# [Optional] Backend bind host. Render listens on 0.0.0.0
HOST=0.0.0.0

# [Note] Render dynamically injects the PORT environment variable at runtime (typically 10000).
# The application must bind to os.environ.get("PORT", 10000).
PORT=10000

# [Optional] Production log verbosity: 'info' or 'warning'. Default: info
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 1.2 CORS (Cross-Origin Resource Sharing)
# ------------------------------------------------------------------------------
# [Required] Production frontend origins permitted to access this API.
# Replace with your actual Vercel deployment URL and custom domain.
CORS_ALLOWED_ORIGINS=https://prooflens-ai.vercel.app,https://your-custom-domain.com

# ------------------------------------------------------------------------------
# 1.3 Database (Supabase PostgreSQL + pgvector)
# ------------------------------------------------------------------------------
# [Required] Supabase PostgreSQL connection string with SSL required.
# Recommended: Use Supabase Transaction Pooler (port 6543) for scalable connection pooling,
# or Session Pooler (port 5432) for standard connections.
# Format: postgresql+asyncpg://postgres.[PROJECT_REF]:[DB_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT_REF]:[DB_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

# [Required] Enforce SSL for all production database connections
DATABASE_SSL_REQUIRED=true

# [Optional] SQLAlchemy connection pool limits tuned for pooled connections
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# ------------------------------------------------------------------------------
# 1.4 AI Provider (Google Gemini API)
# ------------------------------------------------------------------------------
# [Required] Production Google Gemini API key with production quotas.
# Configure exclusively in Render Environment Variables.
GEMINI_API_KEY=replace-me-with-production-gemini-api-key

# [Optional] Model for grounded answer generation. Default: gemini-2.5-flash
GEMINI_GENERATION_MODEL=gemini-2.5-flash

# [Optional] Model for document chunk vector embeddings. Default: text-embedding-004
GEMINI_EMBEDDING_MODEL=text-embedding-004

# [Optional] Request timeout in seconds for Gemini API calls. Default: 45
GEMINI_REQUEST_TIMEOUT_SECONDS=45

# [Optional] Retries with exponential backoff for transient provider rate-limits. Default: 3
GEMINI_MAX_RETRIES=3

# ------------------------------------------------------------------------------
# 1.5 RAG Pipeline & Retrieval Settings
# ------------------------------------------------------------------------------
# [Optional] Target chunk size in characters/tokens. Default: 1000
RAG_CHUNK_SIZE=1000

# [Optional] Chunk overlap. Default: 200
RAG_CHUNK_OVERLAP=200

# [Optional] Number of candidate passages retrieved per query. Default: 5
RAG_TOP_K_RETRIEVAL=5

# [Optional] Minimum cosine similarity score required for relevance. Default: 0.65
RAG_SIMILARITY_THRESHOLD=0.65

# [Optional] Abstention threshold: triggers insufficient-evidence response if below this. Default: 0.50
RAG_ABSTENTION_THRESHOLD=0.50

# ------------------------------------------------------------------------------
# 1.6 Production Document Storage (Unresolved Choice / Implementation Options)
# ------------------------------------------------------------------------------
# NOTE: Render disks are ephemeral unless a paid persistent disk is attached.
# Choose one of the following production storage strategies:

# OPTION A: Supabase Storage (Recommended if using Supabase DB)
STORAGE_BACKEND=supabase
SUPABASE_URL=https://[PROJECT_REF].supabase.co
# [CRITICAL] Service role key bypasses RLS for server-authoritative upload/download.
# NEVER expose this key to the frontend or git!
SUPABASE_SERVICE_ROLE_KEY=replace-me-with-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=prooflens-documents

# OPTION B: AWS S3 / Cloudflare R2 (Unresolved Alternative / TODO)
# STORAGE_BACKEND=s3
# S3_BUCKET_NAME=replace-me-with-s3-bucket-name
# S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID=replace-me-with-aws-access-key-id
# AWS_SECRET_ACCESS_KEY=replace-me-with-aws-secret-access-key

# OPTION C: Render Persistent Disk (Unresolved Alternative / TODO)
# STORAGE_BACKEND=local
# LOCAL_STORAGE_DIR=/var/data/prooflens-uploads

# ------------------------------------------------------------------------------
# 1.7 Upload Limits & Constraints
# ------------------------------------------------------------------------------
# [Optional] Maximum file upload size in bytes (10485760 = 10 MB). Default: 10485760
MAX_UPLOAD_FILE_SIZE_BYTES=10485760

# [Optional] Maximum file count per upload batch. Default: 5
MAX_UPLOAD_FILES_PER_BATCH=5

# [Optional] Allowed file extensions. Default: .pdf
ALLOWED_FILE_EXTENSIONS=.pdf

# ------------------------------------------------------------------------------
# 1.8 Authentication & Security (Unresolved MVP Decision / TODO)
# ------------------------------------------------------------------------------
# [Optional] Set to 'true' if production deployment requires authenticated user sessions.
# If 'false', operates in demo workspace mode.
AUTH_ENABLED=false

# [Required if AUTH_ENABLED=true] Cryptographically secure 32+ byte secret for signing tokens.
# Generate via: openssl rand -hex 32
AUTH_SECRET_KEY=replace-me-with-production-random-32-byte-hex


# ==============================================================================
# 2. FRONTEND SERVICE CONFIGURATION (Vercel Dashboard -> Environment Variables)
# ==============================================================================

# ------------------------------------------------------------------------------
# 2.1 Next.js Runtime Environment
# ------------------------------------------------------------------------------
# Automatically set by Vercel; explicitly set here for containerized/custom environments
NODE_ENV=production

# ------------------------------------------------------------------------------
# 2.2 Public API & Application Endpoints (Exposed to Browser)
# ------------------------------------------------------------------------------
# [Required] Public URL of the FastAPI backend deployed on Render
NEXT_PUBLIC_API_BASE_URL=https://prooflens-backend.onrender.com/api/v1

# [Required] Public production URL of the Next.js frontend hosted on Vercel
NEXT_PUBLIC_APP_URL=https://prooflens-ai.vercel.app

# ------------------------------------------------------------------------------
# 2.3 Server-Side Internal Endpoints (Next.js Server Components / Route Handlers)
# ------------------------------------------------------------------------------
# [Optional] Used by Next.js Server Components or Route Handlers for server-to-server requests
BACKEND_API_INTERNAL_URL=https://prooflens-backend.onrender.com/api/v1

# ------------------------------------------------------------------------------
# 2.4 Client-Side Upload Validation (Mirrors Backend Rules)
# ------------------------------------------------------------------------------
# [Optional] File size limit for client-side dropzone validation (10 MB). Default: 10485760
NEXT_PUBLIC_MAX_UPLOAD_FILE_SIZE_BYTES=10485760

# [Optional] Maximum batch size for client-side dropzone validation. Default: 5
NEXT_PUBLIC_MAX_UPLOAD_FILES_PER_BATCH=5
