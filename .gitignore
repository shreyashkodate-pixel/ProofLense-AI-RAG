# ==============================================================================
# ProofLens AI — Root .gitignore
# Compliance: AGENTS.md Rule Zero (Absolute Secret Zero & Environment Security)
# ==============================================================================

# --- Mandatory Rule Zero: Secrets & Environment Files ---
.env
.env.*
.env.local
.env.development
.env.test
.env.staging
.env.production
*.pem
*.key
*.crt
id_rsa
id_ed25519
*credentials*.json
*service_account*.json

# Explicitly whitelist safe template files
!.env.example
!.env.production.example

# --- Python & Virtual Environments ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
.venv/
venv/
ENV/
env/
.venv*/

# Testing & Quality Assurance
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/
.ruff_cache/
.mypy_cache/

# --- Node.js & Next.js Frontend ---
node_modules/
.next/
out/
.vercel
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Local Document Storage & Temporary Uploads ---
data/uploads/*
!data/uploads/.gitkeep
data/processed/*
!data/processed/.gitkeep
*.tmp

# --- OS & IDE Metadata ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# IDE & Editor files
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
