# ==============================================================================
# ProofLens AI — Local Development Environment Configuration Template
# File: .env.example
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to '.env' in your local development root:
#      cp .env.example .env
# 2. Replace all placeholder values (e.g. 'replace-me-locally') with your actual credentials.
# 3. NEVER commit your actual '.env' file or any secret keys to version control.
# 4. NEVER expose backend keys (like GEMINI_API_KEY) in frontend variables (NEXT_PUBLIC_*).
# ==============================================================================

# ==============================================================================
# BACKEND CONFIGURATION (Python / FastAPI)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Server Runtime
# ------------------------------------------------------------------------------
# [Required] Runtime environment: 'development', 'test', or 'production'
ENVIRONMENT=development

# [Optional] Enable debug mode (auto-reload, verbose diagnostics). Default: true
DEBUG=true

# [Optional] Backend bind host. Default: 0.0.0.0
HOST=0.0.0.0

# [Optional] Backend bind port. Default: 8000
PORT=8000

# [Optional] Logging verbosity: 'debug', 'info', 'warning', 'error'. Default: info
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 2. CORS (Cross-Origin Resource Sharing)
# ------------------------------------------------------------------------------
# [Required] Comma-separated list of allowed frontend origins for local browser requests
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# 3. Database (PostgreSQL + pgvector)
# ------------------------------------------------------------------------------
# [Required] Connection string for local PostgreSQL instance with pgvector extension enabled.
# Standard local format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/prooflens_dev

# [Optional] Echo raw SQL statements to console. Default: false
DATABASE_ECHO=false

# [Optional] Connection pool size. Default: 10
DATABASE_POOL_SIZE=10

# [Optional] Connection pool overflow limit. Default: 20
DATABASE_MAX_OVERFLOW=20

# ------------------------------------------------------------------------------
# 4. AI Provider (Google Gemini API)
# ------------------------------------------------------------------------------
# [Required] Google Gemini API Key from Google AI Studio (https://aistudio.google.com/)
# NEVER expose this key to the frontend!
GEMINI_API_KEY=replace-me-locally

# [Optional] Model for evidence-grounded answer generation. Default: gemini-2.5-flash
GEMINI_GENERATION_MODEL=gemini-2.5-flash

# [Optional] Model for document text chunk embeddings. Default: text-embedding-004 (768 dimensions)
GEMINI_EMBEDDING_MODEL=text-embedding-004

# [Optional] Request timeout in seconds for Gemini API calls. Default: 30
GEMINI_REQUEST_TIMEOUT_SECONDS=30

# [Optional] Maximum retries with exponential backoff on transient errors. Default: 3
GEMINI_MAX_RETRIES=3

# ------------------------------------------------------------------------------
# 5. RAG Pipeline & Retrieval Settings
# ------------------------------------------------------------------------------
# [Optional] Target chunk size in characters or tokens. Default: 1000
RAG_CHUNK_SIZE=1000

# [Optional] Overlap between consecutive chunks. Default: 200
RAG_CHUNK_OVERLAP=200

# [Optional] Top K candidate passages to retrieve for a query. Default: 5
RAG_TOP_K_RETRIEVAL=5

# [Optional] Minimum cosine similarity threshold (0.0 to 1.0) to include a passage. Default: 0.65
RAG_SIMILARITY_THRESHOLD=0.65

# [Optional] Abstention threshold: abstain if top retrieved passage similarity is below this score. Default: 0.50
RAG_ABSTENTION_THRESHOLD=0.50

# ------------------------------------------------------------------------------
# 6. Document Storage & Ingestion Limits
# ------------------------------------------------------------------------------
# [Required] Local storage backend: 'local' (stores uploaded PDFs on filesystem)
STORAGE_BACKEND=local

# [Required when STORAGE_BACKEND=local] Relative or absolute directory for uploaded files. Default: ./data/uploads
LOCAL_STORAGE_DIR=./data/uploads

# [Optional] Maximum upload size per PDF file in bytes (10485760 = 10 MB). Default: 10485760
MAX_UPLOAD_FILE_SIZE_BYTES=10485760

# [Optional] Maximum number of files permitted in a single upload batch. Default: 5
MAX_UPLOAD_FILES_PER_BATCH=5

# [Optional] Allowed file extensions (comma-separated). Default: .pdf
ALLOWED_FILE_EXTENSIONS=.pdf

# ------------------------------------------------------------------------------
# 7. Authentication & Security (Unresolved MVP Decision / TODO)
# ------------------------------------------------------------------------------
# [Optional] Enable workspace authentication. For MVP demo, defaults to false (single-user demo mode).
# TODO: Confirm whether persistent multi-user auth is required before production.
AUTH_ENABLED=false

# [Optional] Secret key for signing sessions/tokens if AUTH_ENABLED=true.
# Generate via: openssl rand -hex 32
AUTH_SECRET_KEY=replace-me-locally-with-a-random-32-byte-hex


# ==============================================================================
# FRONTEND CONFIGURATION (Next.js / TypeScript)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Next.js Runtime Environment
# ------------------------------------------------------------------------------
# [Required] Node environment mode: 'development', 'test', or 'production'
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. Public API & Application Endpoints (Exposed to Browser)
# ------------------------------------------------------------------------------
# [Required] Backend API base URL accessible from the user's browser
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# [Required] Public URL where the frontend is hosted locally
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 3. Server-Side Internal Endpoints (Next.js Server Components / Route Handlers)
# ------------------------------------------------------------------------------
# [Optional] Direct server-to-server endpoint for Next.js SSR / API routes if bypassing public routing
BACKEND_API_INTERNAL_URL=http://localhost:8000/api/v1

# ------------------------------------------------------------------------------
# 4. Client-Side Validation Limits (Mirrors Backend Rules)
# ------------------------------------------------------------------------------
# [Optional] Maximum file upload size in bytes for client-side dropzone validation (10 MB). Default: 10485760
NEXT_PUBLIC_MAX_UPLOAD_FILE_SIZE_BYTES=10485760

# [Optional] Maximum file count per upload batch for client-side dropzone validation. Default: 5
NEXT_PUBLIC_MAX_UPLOAD_FILES_PER_BATCH=5
